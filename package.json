{
  "name": "voda-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:apk:dev": "cd android && rm -rf app/build/generated/assets/createBundleReleaseJsAndAssets app/build/generated/res/createBundleReleaseJsAndAssets && EXPO_PUBLIC_WEBVIEW_ORIGIN=https://voda-dev.ppiyakworld.com EXPO_PUBLIC_ENABLE_QA_TOOLS=true ./gradlew assembleRelease --parallel -PreactNativeArchitectures=armeabi-v7a,arm64-v8a -Dorg.gradle.jvmargs='-Xmx4g -XX:MaxMetaspaceSize=1g'",
    "build:aab:prod": "cd android && rm -rf app/build/generated/assets/createBundleReleaseJsAndAssets app/build/generated/res/createBundleReleaseJsAndAssets && ./gradlew bundleRelease --parallel -PreactNativeArchitectures=armeabi-v7a,arm64-v8a -Dorg.gradle.jvmargs='-Xmx4g -XX:MaxMetaspaceSize=1g' && cd .. && sh scripts/archive-release-artifacts.sh",
    "build:clean": "cd android && rm -rf app/.cxx && ./gradlew clean"
  },
  "dependencies": {
    "babel-preset-expo": "~54.0.10",
    "expo": "^54",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-media-library": "~18.2.1",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
